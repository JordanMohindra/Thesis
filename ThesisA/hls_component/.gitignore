# ---------------------------------------------------------------------------
# Vitis HLS build output. None of this is a source file - it is regenerated by
#   v++ -c --mode hls        (C synthesis)
#   vitis-run --mode hls ... (csim / cosim)
# ---------------------------------------------------------------------------

# Component working directories (--work_dir targets)
hls_component/
hls_edge/
hls_build/
_ide/
.Xil/
.cache/
.hls.failed

# Vitis / Vivado scratch
*.jou
*.str
.autopilot/
.debug/

# Generated build/run scripts (recreated on demand)
run_*.bat

# Object, dependency and log files
*.o
*.d
*.log
*.lock
*.pdi
.vitisWorkspace.json

# Test vectors and exported frame data - regenerate with
#   export_frames_for_vitis.m  in Matlab_Sim
*.bin
